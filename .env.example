# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_DEMO_MODE: Enables Prototype Demo Mode (/demo launcher and collapsible demo toolbar).
# Set to "true" for stakeholder prototype deployments; set to "false" for production.
VITE_DEMO_MODE="true"

# VITE_5TOT_EXECUTION_MODE: Dual-Mode Execution Switch ("DEMO" | "BACKEND").
# Defaults to "DEMO" so Interactive Demo Mode works offline without PostgreSQL.
VITE_5TOT_EXECUTION_MODE="DEMO"

# ============================================================================
# BACKEND V2 PRODUCTION CONFIGURATION (BE1–BE9)
# ============================================================================

# PostgreSQL 16+ Connection String (Cloud SQL / PostgreSQL with per-instance pool cap)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sv5t_danang_v2?schema=public&connection_limit=10&pool_timeout=10&connect_timeout=5"

# Zero-Trust Authentication & Session Secrets (Injected via Secret Manager in Staging/Prod)
JWT_ACCESS_SECRET="replace-with-256-bit-access-secret"
REFRESH_TOKEN_PEPPER="replace-with-256-bit-refresh-pepper"

# Private Durable Object Storage (Google Cloud Storage / S3-Compatible)
EVIDENCE_STORAGE_BUCKET="5tot-danang-private-evidence"
EVIDENCE_PRESIGNED_PUT_TTL_SECONDS="300"
EVIDENCE_PRESIGNED_GET_TTL_SECONDS="120"
